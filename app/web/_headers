# The entry points must never be served stale: index.html names the current
# bundle, and flutter_service_worker.js is the self-destruct that evicts the
# old offline cache from phones that still carry it. Everything else keeps
# the platform's etag revalidation, which is what makes updates instant
# without refetching unchanged megabytes.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
