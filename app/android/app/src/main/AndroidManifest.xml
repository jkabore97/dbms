<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The barcode scanner opens the camera directly (mobile_scanner), so it
         needs this. The photo button does not: image_picker hands off to the
         camera app through an intent, which carries its own permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Unlock with a fingerprint instead of the code (Sécurité). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The buzz of a new order (Compte › Préférences › Sons des
         notifications, switchable off). A normal permission: granted at
         install, never asked. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The bell with the app closed (115, Firebase Cloud Messaging). On
         Android 13 and later it is asked from the « Activer » button of the
         push offer, never at start-up. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The vitrine map: "utiliser ma position" places a shop on the map
         from where the phone is, and "près de moi" sorts the directory by
         distance. Asked for only when one of those is tapped, never at
         start-up; the app is fully usable with it refused. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- A phone with no camera can still do everything else in the app: the
         gallery, the ledger, the reports. Required="false" keeps it
         installable on one rather than being filtered out of the store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="Mara"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Downloads the text-recognition model at install time instead of
             on first use. Without it the first photograph somebody takes
             either waits on a download or silently reads nothing — and the
             one place that happens is a shop with poor signal, which is
             every shop this is for. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,barcode" />
        <!-- The channel MainActivity makes at start (115): FCM rings on it
             rather than on a fallback channel of its own. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mara_alerts" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Google sign-in comes back here: the browser opens
                 bf.kaj.app://login-callback?code=… and supabase_flutter
                 turns the code into a session (AuthRepository.androidCallback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="bf.kaj.app" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
