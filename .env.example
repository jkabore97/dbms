# Copy to .env and fill with real values.
# Never commit .env. Never paste these values into a chat, including this one.

# Supabase (database + auth)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The publishable key (formerly the anon key) is safe in the client — RLS is
# what protects the data. The service_role/secret key is server-side only
# (Cloudflare Worker secret) and never belongs in this file, in the app, or
# in a chat message.

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=kaj-app-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Firebase — push notifications + crash reporting only, not the database
FIREBASE_PROJECT_ID=

# App defaults
DEFAULT_LOCALE=fr
